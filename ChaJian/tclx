[Script]
# 捕获请求头，获取signIndex请求头
http-request ^https:\/\/app\.17u\.cn\/welfarecenter\/index\/signIndex script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/tongcheng-trip/tongcheng-trip.js, tag=同程旅行-捕获请求头, require-body=false

# 定时签到任务，每天12点05分执行
cron "5 12 * * *" script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/tongcheng-trip/tongcheng-trip.js, timeout=300, tag=同程旅行-自动签到

[MITM]
hostname = app.17u.cn

[Panel]
同程旅行签到 = script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/tongcheng-trip/tongcheng-trip.js, title=同程旅行签到, content=点击运行手动执行签到
